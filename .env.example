# ─────────────────────────────────────────────────────────────────────────────
# Urban Store AI Commerce OS — local environment
# Fill in the blanks. NEVER commit this file. NEVER add a secret to a
# NEXT_PUBLIC_* var — those are inlined into the browser bundle.
# ─────────────────────────────────────────────────────────────────────────────

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL=

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL=

# ── Razorpay (TEST MODE ONLY) ───────────────────────────────────────────────
# Server-side. The secret must never reach the browser.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set this to the same value you enter in Dashboard → Settings → Webhooks.
# Used to verify the X-Razorpay-Signature HMAC. A webhook is the ONLY thing
# that may mark an order paid.
RAZORPAY_WEBHOOK_SECRET=
# Public key id for the Razorpay Checkout script in the browser.
# This is the key_id only — safe to expose, and it must equal RAZORPAY_KEY_ID.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ── Auth (Clerk) ────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_URL=
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=

# ── LLM (Groq — free tier, behind the /lib provider abstraction) ────────────
# OpenAI-compatible API. Use the `openai` SDK pointed at Groq's base URL,
# or @langchain/groq for the LangGraph agents.
LLM_PROVIDER=
GROQ_API_KEY=
GROQ_BASE_URL=
# Reasoning model for the router / recommendation / support agents.
# Supports tool calling + JSON mode — both required by the agent layer.
LLM_MODEL=
# Cheap fast model for classification-style calls (intent tags, guardrails).
LLM_FAST_MODEL=
# Free tier is rate-limited per minute — keep a retry/backoff in the provider.
LLM_MAX_RETRIES=
LLM_TIMEOUT_MS=

# ── Embeddings for RAG (pgvector) ───────────────────────────────────────────
# Groq has NO embeddings endpoint. Default here is a local model that runs
# in-process via @xenova/transformers — no API key, no rate limit, no network
# call during the demo. The corpus is only 3-4 policy docs, so this is fast.
#   npm i @xenova/transformers
#   next.config.js → serverExternalPackages: ['@xenova/transformers']
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
# Must match the vector(N) column width in prisma/schema.prisma.
EMBEDDING_DIMENSIONS=

# Hosted free-tier alternatives — switch EMBEDDING_PROVIDER and uncomment one:
# EMBEDDING_PROVIDER=gemini
# GOOGLE_API_KEY=
# EMBEDDING_MODEL=text-embedding-004      # EMBEDDING_DIMENSIONS=768
#
# EMBEDDING_PROVIDER=jina
# JINA_API_KEY=
# EMBEDDING_MODEL=jina-embeddings-v3      # EMBEDDING_DIMENSIONS=1024

# ── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=
NEXT_PUBLIC_APP_URL=
# Public base URL Razorpay can reach for webhooks (ngrok/cloudflared tunnel
# in dev). Webhook endpoint = $APP_BASE_URL/api/webhooks/razorpay
APP_BASE_URL=

# ── Agent API surface (autonomous agents shopping via /api/agent/*) ─────────
# Shared secret an external agent sends as `Authorization: Bearer <key>`.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_API_KEY=

# ── Policy engine defaults (spending bounds for agent purchases, in paise) ──
AGENT_MAX_ORDER_VALUE_PAISE=
AGENT_DAILY_SPEND_CAP_PAISE=
AGENT_APPROVAL_THRESHOLD_PAISE=

# ── Roles ───────────────────────────────────────────────────────────────────
# The Clerk user with this email is promoted to merchant_admin on first sign-in.
MERCHANT_ADMIN_EMAIL=

# ── Email (Resend, sandbox) ─────────────────────────────────────────────────
# Campaign approval sends the campaign copy to reachable recipients.
# Leave RESEND_API_KEY blank and approval still works — it just reports that
# nothing could be sent.
RESEND_API_KEY=
# Sandbox must send from a Resend-owned address until a domain is verified.
RESEND_FROM=
# Comma-separated addresses verified on your Resend account. Sandbox delivers
# ONLY to these; anything else is reported as unreachable rather than bounced.
RESEND_ALLOWED_RECIPIENTS=

# Internal payment harness at /test-spine (create synthetic carts, drive Razorpay
# order creation by hand). Development builds enable it implicitly; a production
# build needs this set to "true". Never enable it on a public deployment.
ENABLE_TEST_SPINE=false

# How long a cart whose payment was declined must sit before the growth agent
# may target it for recovery. The cart stays active throughout, so the buyer
# can still retry; this only governs campaign eligibility.
#
# 1800000 = 30 minutes. Long enough that someone reaching for a second card is
# not emailed mid-retry. Lower values are for demos only.
FAILED_CART_ELIGIBLE_AFTER_MS=1800000
